{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/next"
        },
        {
            "src": "backend/index.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "backend/index.js"
        },
        {
            "source": "/_next/:path*",
            "destination": "frontend/_next/:path*"
        },
        {
            "source": "/assets/:path*",
            "destination": "frontend/assets/:path*"
        },
        {
            "source": "/:path*",
            "destination": "frontend/:path*"
        }
    ]
}