# =================================================================
#  MakeEasyTrip Full-Stack Server Configuration Options
# =================================================================

# Server Options
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase Connection String)
# Replace placeholder with your real Supabase Connection Pooler string
DATABASE_URL="postgresql://postgres.placeholder-url:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"

# JSON Web Tokens Secret
JWT_SECRET="makeeasytrip-super-secret-key-2026"

# SMTP Configuration (Nodemailer Email Alerts)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
FROM_EMAIL="no-reply@makeeasytrip.com"

# Razorpay Configuration (Payments Gateways)
RAZORPAY_KEY_ID="rzp_test_keyid"
RAZORPAY_KEY_SECRET="rzp_test_keysecret"
