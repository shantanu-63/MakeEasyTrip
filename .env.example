# =================================================================
#  MakeEasyTrip Production-Ready Root Configuration Options
# =================================================================

# -----------------------------------------------------------------
#  BACKEND SERVER CONFIGURATION (.env inside /backend)
# -----------------------------------------------------------------
# Port number for the Express API server
PORT=5000
NODE_ENV=development

# Database Configuration (Supabase PostgreSQL Connection String)
# Example connection pooler URL:
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true"

# JSON Web Tokens Secret (use a secure random string in production)
JWT_SECRET="makeeasytrip-super-secret-key-2026"

# SMTP Configuration (Nodemailer Email Alerts)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="no-reply@makeeasytrip.com"

# Razorpay Configuration (Payments Gateways)
RAZORPAY_KEY_ID="rzp_test_keyid"
RAZORPAY_KEY_SECRET="rzp_test_keysecret"

# -----------------------------------------------------------------
#  FRONTEND CLIENT CONFIGURATION (.env.local inside /frontend)
# -----------------------------------------------------------------
# API URL linking the frontend to the Express backend
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Supabase Auth Client Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
